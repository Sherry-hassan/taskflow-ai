# MongoDB connection string. Must point to a replica-set-enabled MongoDB instance
# (required for multi-document transactions — see README.md at the repo root).
MONGODB_URI=

# Port the server listens on. Optional; defaults to 3001 if unset.
PORT=3001

# JWT signing secret for access tokens (FR-004). Added in M1 — generate a long random
# value for real use; never commit a real value here.
JWT_SECRET=

# Anthropic Claude API key (FR-050 AI orchestration). Added in M4. Automated tests
# never call the real API — this is only read by server/src/services/aiProvider.js
# when actually running the app.
ANTHROPIC_API_KEY=

# --- Local-development-only alternative to the Anthropic API below. Production
# remains committed to Anthropic (docs/legal/privacy-policy.md,
# terms-of-service.md) — these three variables exist solely so a developer can
# run the three AI features against a local Ollama instance instead of paying
# for/requiring real Anthropic API access while developing. Leave AI_PROVIDER
# unset in any real deployment. ---

# Selects which backend server/src/services/aiProvider.js's callClaude()
# delegates to: "anthropic" (default if unset) or "ollama". Unset/anthropic
# requires ANTHROPIC_API_KEY above; "ollama" requires a local Ollama instance
# running (see OLLAMA_BASE_URL/OLLAMA_MODEL) and does NOT need
# ANTHROPIC_API_KEY set at all.
AI_PROVIDER=

# Base URL of the local Ollama server. Defaults to http://127.0.0.1:11434
# (Ollama's standard local port) if unset. Only read when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=

# Ollama model name to use for all three AI features. Defaults to "qwen3:8b"
# if unset. Must already be pulled locally (`ollama pull <model>`) — Ollama
# returns 404 otherwise, surfaced as a typed AIProviderError. Only read when
# AI_PROVIDER=ollama.
OLLAMA_MODEL=

# Per-request timeout in milliseconds for calls to the local Ollama server.
# Defaults to 120000 (120s) if unset. Only read when AI_PROVIDER=ollama.
# qwen3:8b on CPU-only hardware was observed taking 30-50s for a simple JSON
# completion — raise this further if generation still times out on slower
# hardware or larger prompts.
OLLAMA_TIMEOUT_MS=

# Shared secret for the restricted internal diagnostic route (FR-125/US-066). Added
# in M4. This is a distinct operator credential, structurally unrelated to any
# workspace-role JWT — issue it out-of-band to engineering/support tooling only.
OPERATOR_DIAGNOSTIC_TOKEN=

# SMTP configuration for the two transactional emails (password reset, invitation —
# FR-094/FR-095). Added in Phase 2 (production-readiness). Read by
# server/src/services/emailProvider.js — never logged, never committed with a real
# value. If any of these five is unset, email sending fails safely (a typed,
# caught error) rather than throwing an unhandled exception; the password-reset and
# invitation endpoints keep their existing response behavior regardless.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Base URL of the frontend application, used to build the clickable link inside
# password-reset and invitation emails (e.g. https://app.example.com). Added in
# Phase 2; the app shell built in Phase 3 provides the /invitations/:token/accept
# route, and Phase 4 added the /reset-password route — both links resolve to a
# real page. Leaving this unset produces a relative-looking link (no host)
# rather than failing the send.
APP_BASE_URL=

# --- The two variables below are test/E2E-only escape hatches. Never set
# either of these for a real deployment. ---

# Overrides the Anthropic SDK client's base URL (server/src/services/aiProvider.js).
# Added in Phase 3 so the Playwright E2E harness can point the real orchestration
# code at a local fixture server instead of the real Anthropic API. Leave unset
# in every real environment — the SDK then uses its normal default endpoint.
ANTHROPIC_BASE_URL=

# When exactly "true", disables the /auth/login and /auth/password-reset/request
# rate limiters (server/src/routes/authRoutes.js). Added in Phase 3 so a full
# Playwright run from one machine/IP doesn't trip real abuse-prevention limits.
# Leave unset in every real environment — the limiters are a real security
# control (threat-model.md §4.1/§4.5) and this flag exists solely for test
# infrastructure, never for production convenience.
RATE_LIMIT_DISABLED=
