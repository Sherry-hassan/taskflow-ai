# MongoDB connection string. Must point to a replica-set-enabled MongoDB instance
# (required for multi-document transactions — see README.md at the repo root).
MONGODB_URI=

# Port the server listens on. Optional; defaults to 3001 if unset.
PORT=3001

# JWT signing secret for access tokens (FR-004). Added in M1 — generate a long random
# value for real use; never commit a real value here.
JWT_SECRET=

# Anthropic Claude API key (FR-050 AI orchestration). Added in M4. Automated tests
# never call the real API — this is only read by server/src/services/aiProvider.js
# when actually running the app.
ANTHROPIC_API_KEY=

# Shared secret for the restricted internal diagnostic route (FR-125/US-066). Added
# in M4. This is a distinct operator credential, structurally unrelated to any
# workspace-role JWT — issue it out-of-band to engineering/support tooling only.
OPERATOR_DIAGNOSTIC_TOKEN=

# SMTP configuration for the two transactional emails (password reset, invitation —
# FR-094/FR-095). Added in Phase 2 (production-readiness). Read by
# server/src/services/emailProvider.js — never logged, never committed with a real
# value. If any of these five is unset, email sending fails safely (a typed,
# caught error) rather than throwing an unhandled exception; the password-reset and
# invitation endpoints keep their existing response behavior regardless.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Base URL of the frontend application, used to build the clickable link inside
# password-reset and invitation emails (e.g. https://app.example.com). Added in
# Phase 2. IMPORTANT: no application UI shell exists yet (see README.md's Current
# Limitations) — the generated links will not resolve to a working page until the
# corresponding frontend routes are built. Leaving this unset produces a
# relative-looking link (no host) rather than failing the send.
APP_BASE_URL=
